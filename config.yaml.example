# atc — Air Traffic Control config
# Copy to config.yaml and fill in your values.
# config.yaml is gitignored — never commit it.
#
# ── Secrets ──────────────────────────────────────────────────────────────────
# Sensitive values can be stored in your system keychain instead of plain text.
# Use the sentinel:  keychain:<key-name>
#
#   token_value: keychain:pve-01-token
#
# On first run atc will prompt for the value and store it securely.
# To manage stored secrets:
#   atc secrets          # list all
#   atc secrets set <key>
#   atc secrets delete <key>

proxmox:
  # Create an API token: Proxmox UI → Datacenter → Permissions → API Tokens
  # Recommended: dedicated user (e.g. atc@pve) with Sys.Audit + VM.Monitor roles
  nodes:
    - name: pve-01
      host: 192.168.x.x
      port: 8006
      user: root@pam
      token_name: atc
      token_value: keychain:pve-01-token   # ← stored in keychain
      verify_ssl: false

    - name: pve-02
      host: 192.168.x.x
      port: 8006
      user: root@pam
      token_name: atc
      token_value: keychain:pve-02-token
      verify_ssl: false

    - name: pve-03
      host: 192.168.x.x
      port: 8006
      user: root@pam
      token_name: atc
      token_value: keychain:pve-03-token
      verify_ssl: false

ssh:
  # Used when SSHing into nodes, VMs, and LXCs to run apt upgrades.
  # Requires SSH server running and your key authorized on each target.
  default_user: root
  key_file: ~/.ssh/id_rsa
  connect_timeout: 10
  # How to resolve Proxmox node names to SSH hostnames.
  # {name} is replaced with the node name returned by the cluster API.
  # Default "{name}" works if short names resolve (e.g. via Pi-hole DNS).
  # Example: "pve-{name}.local.example.com"
  node_host_pattern: "{name}"

dsm:
  # Synology DSM HTTP API — read-only health checks.
  # DSM ports: 5000 (HTTP) or 5001 (HTTPS)
  - name: Globemaster
    host: 192.168.x.x
    port: 5000
    https: false
    user: your_dsm_user
    password: keychain:dsm-globemaster-password  # ← stored in keychain
    verify_ssl: false

  # Add a second DSM instance if needed:
  # - name: SecondNAS
  #   host: 192.168.x.x
  #   port: 5000
  #   https: false
  #   user: your_dsm_user
  #   password: keychain:dsm-secondnas-password
  #   verify_ssl: false

# Path to scan for *.sh scripts (relative to this config file's directory).
scripts_dir: "../../"

# Dashboard auto-refresh interval in seconds
refresh_interval: 30
