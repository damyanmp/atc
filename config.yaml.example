# atc — Air Traffic Control config
# Recommended: put this file at ~/.config/atc/config.yaml (outside any git
# working tree) instead of next to this script — gitignored still means the
# file sits inside a repo folder, one `git add -A`/misconfigured .gitignore
# away from being tracked. Override the location entirely with $ATC_CONFIG.
# config.yaml is gitignored — never commit it.
#
# ── Secrets ──────────────────────────────────────────────────────────────────
# Sensitive values can be stored in your system keychain instead of plain text.
# Use the sentinel:  keychain:<key-name>
#
#   token_value: keychain:pve-01-token
#
# On first run atc will prompt for the value and store it securely.
# To manage stored secrets:
#   atc secrets          # list all
#   atc secrets set <key>
#   atc secrets delete <key>

# ── General ───────────────────────────────────────────────────────────────────

# Folder atc scans for *.sh scripts to run via `atc run`.
# Leave unset to default to a `scripts/` folder next to this config file.
# Set an absolute path to point anywhere on disk — easiest via:
#   atc run set-dir /path/to/scripts
# scripts_dir: "/path/to/your/scripts"

# Dashboard auto-refresh interval in seconds.
refresh_interval: 30

# ── Infrastructure ────────────────────────────────────────────────────────────

proxmox:
  # Connect to any single cluster node — the cluster API returns all nodes and
  # guests automatically.
  # Create an API token: Proxmox UI → Datacenter → Permissions → API Tokens
  # Recommended: dedicated user (e.g. atc@pve) with Sys.Audit + VM.Monitor roles.
  host: 192.168.x.x
  port: 8006
  user: root@pam
  token_name: atc
  token_value: keychain:pve-token   # ← stored in keychain
  verify_ssl: false

ssh:
  # Used when SSHing into nodes, VMs, and LXCs (e.g. apt upgrades, key injection).
  # Requires SSH server running and your key authorized on each target.
  default_user: root
  key_file: ~/.ssh/id_rsa
  connect_timeout: 10

  # How to resolve Proxmox node names to SSH hostnames.
  # {name} is replaced with the node name returned by the cluster API.
  # Default "{name}" works if short names resolve via DNS (e.g. Pi-hole).
  # Example: "pve-{name}.local.example.com"
  node_host_pattern: "{name}"

  # Set to true to enforce ~/.ssh/known_hosts checking.
  # Default false is appropriate for trusted home networks.
  verify_host_keys: false

  # Per-guest SSH user overrides (optional).
  # Keys are guest names; values are the SSH user to connect as.
  # Can also be managed via `atc get push-key` and stored in guest_users.yaml.
  # guest_users:
  #   my-ubuntu-vm: ubuntu
  #   my-debian-lxc: debian

# ── Monitoring: Beszel ────────────────────────────────────────────────────────

beszel:
  # Beszel hub — lightweight host monitoring (CPU, memory, disk).
  # Replaces per-service health checks for non-Proxmox hosts (NAS, Docker hosts, etc.)
  host: beszel.local.example.com
  port: 443
  https: true
  # Preferred: your Beszel login. atc mints a fresh PocketBase auth token on
  # every single API call instead of reusing one saved token — since nothing
  # is cached, there's no stale/expired token to ever regenerate by hand.
  email: keychain:beszel-email        # ← stored in keychain
  password: keychain:beszel-password  # ← stored in keychain
  # Legacy alternative: a pre-generated static JWT (Beszel UI → Settings →
  # API Keys → Create). WILL expire periodically and has to be regenerated
  # by hand when it does — only use this if you don't want atc to hold your
  # Beszel login. Leave blank/omit if using email+password above.
  # api_key: keychain:beszel-api-key
  verify_ssl: false

# ── Network ───────────────────────────────────────────────────────────────────

unifi:
  # UniFi Network Application — firewall rules, VLANs, network config.
  # Auth option 1 (recommended): API key — UniFi Network 8.x+
  #   Generate: Network UI → Settings → Control Plane → Integrations → Create API Key
  # Auth option 2 (legacy): username + password (cookie-based session)
  host: 192.168.x.x        # IP or hostname of UDM / Cloud Key / controller
  port: 443
  https: true
  udm: true                # true for UDM/UDR (adds /proxy/network/ prefix); false for standalone controller
  site: default            # UniFi site name (usually "default")
  api_key: keychain:unifi-api-key   # ← preferred; comment out if using username/password
  # username: admin
  # password: keychain:unifi-password
  verify_ssl: false

pihole:
  # Pi-hole v6 HTTP API — DNS blocking status, gravity sync, custom DNS.
  # Generate a password in Pi-hole: Settings → API / Web interface.
  - name: Primary
    host: 192.168.x.x
    port: 80
    https: false
    password: keychain:pihole-primary-password   # ← stored in keychain
    verify_ssl: false
    primary: true   # primary instance is used for gravity sync and custom DNS writes

  # - name: Secondary
  #   host: 192.168.x.x
  #   port: 80
  #   password: keychain:pihole-secondary-password
  #   primary: false

# ── Home Automation ───────────────────────────────────────────────────────────

homeassistant:
  # Home Assistant REST API — entity states, updates, automations.
  # Generate a long-lived access token: HA UI → Profile → Long-Lived Access Tokens.
  host: 192.168.x.x
  port: 8123
  https: false
  token: keychain:ha-token   # ← stored in keychain
  verify_ssl: false

  # Optional stat widgets shown in the TUI dashboard header.
  # stats:
  #   - name: Indoor
  #     entity: sensor.living_room_temperature
  #     unit: "°C"
  #   - name: Outdoor
  #     entity: sensor.outdoor_temperature
  #     unit: "°C"

# ── Media ─────────────────────────────────────────────────────────────────────

plex:
  # Plex Media Server API.
  # Get your token: https://support.plex.tv/articles/204059436
  host: 192.168.x.x
  port: 32400
  https: false
  token: keychain:plex-token   # ← stored in keychain
  verify_ssl: false

radarr:
  # Radarr — movie collection manager.
  # API key: Radarr UI → Settings → General → API Key.
  host: 192.168.x.x
  port: 7878
  https: false
  api_key: keychain:radarr-api-key   # ← stored in keychain
  verify_ssl: false
  # base_path: /radarr   # uncomment if Radarr is behind a reverse proxy subpath

sonarr:
  # Sonarr — TV show collection manager.
  # API key: Sonarr UI → Settings → General → API Key.
  host: 192.168.x.x
  port: 8989
  https: false
  api_key: keychain:sonarr-api-key   # ← stored in keychain
  verify_ssl: false
  # base_path: /sonarr   # uncomment if Sonarr is behind a reverse proxy subpath

tautulli:
  # Tautulli — Plex monitoring (active streams, play history).
  # Generate an API key: Tautulli UI → Settings → Web Interface → API key.
  host: 192.168.x.x
  port: 8181
  https: false
  api_key: keychain:tautulli-api-key   # ← stored in keychain
  verify_ssl: false

seerr:
  # Overseerr or Jellyseerr — media request management.
  # API key: Overseerr UI → Settings → General → API Key.
  host: 192.168.x.x
  port: 443
  https: true
  api_key: keychain:seerr-api-key   # ← stored in keychain
  verify_ssl: false

# ── Monitoring ────────────────────────────────────────────────────────────────

prometheus:
  # Prometheus — used by blackbox to include firing/pending alert rules.
  # No auth required for most self-hosted instances.
  host: 192.168.x.x
  port: 9090
  https: false
  verify_ssl: false

loki:
  # Loki — used by blackbox to include filtered syslog (job="syslog") and
  # Pi-hole (job="pihole") log lines. No auth required for most self-hosted instances.
  host: 192.168.x.x
  port: 3100
  https: false
  verify_ssl: false

influxdb:
  # InfluxDB 2.x — used for data sources with their own push-based metric
  # server (e.g. Proxmox's built-in InfluxDB metric export), as an
  # alternative to the pull-based Prometheus/exporter model.
  # Generate a token: InfluxDB UI → Load Data → API Tokens → Generate.
  # Prefer a Custom (per-bucket, read-only) token if your instance offers
  # one; some deployments only expose "All Access" — if so, treat it as
  # query-only in your own tooling regardless of what the token permits.
  host: 192.168.x.x
  org: <org-id-or-name>
  port: 8086
  https: false
  verify_ssl: false
  token: keychain:influxdb-api-key   # ← stored in keychain

openspeedtest:
  # Self-hosted OpenSpeedTest server (docker: openspeedtest/latest).
  # No auth required — just point at the host and port.
  host: 192.168.x.x
  port: 3000
  https: false
  verify_ssl: false

uptimekuma:
  # Uptime Kuma — service uptime monitoring (louislam/uptime-kuma).
  # With api_key: uses /metrics endpoint (Prometheus) — all monitors, no status page needed.
  # Without api_key: uses public status page API — slug must be a public status page.
  # Generate an API key: Uptime Kuma → Settings → API Keys → Add API Key.
  host: 192.168.x.x
  port: 3001
  https: false
  api_key: keychain:uptimekuma-api-key   # ← stored in keychain
  # slug: main   # status page slug for outage history (e.g. /status/main → slug: main)
  verify_ssl: false

portainer:
  # Portainer — unified Docker management across multiple hosts.
  # Supports CE and EE. Used by blackbox to collect container logs from all
  # connected Docker environments (via Portainer agents).
  # Generate a token: Portainer UI → Account → Access tokens → Add access token.
  host: 192.168.x.x
  port: 9000
  https: false
  api_key: keychain:portainer-api-key   # ← stored in keychain
  verify_ssl: false

tls:
  # TLS certificate expiry checks — shown in the dashboard.
  # sni: override SNI for wildcard certs on internal IPs.
  - name: Router
    host: 192.168.x.x
    port: 443
    verify_ssl: false
  # - name: NAS
  #   host: nas.local.example.com
  #   port: 443
  #   sni: nas.local.example.com
  #   verify_ssl: false

# ── Blackbox ──────────────────────────────────────────────────────────────────

# blackbox:
#   # Extra SSH hosts to collect journalctl error logs from (in addition to
#   # Proxmox nodes which are auto-discovered via the Proxmox API).
#   # Use this to include standalone Docker hosts, NAS boxes, etc.
#   ssh_hosts:
#     - name: docker-1
#       host: 192.168.x.x
#       # user: root   # optional — defaults to ssh.default_user
